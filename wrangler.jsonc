{
  // English Geniuses – Cloudflare Worker with static assets and a D1 database.
  // "name" must match the Worker's name in your Cloudflare dashboard.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obz-english",
  "main": "src/worker.js",
  "compatibility_date": "2025-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // No database_id: Wrangler creates the D1 database and binds it automatically on the first deploy.
  "d1_databases": [
    { "binding": "DB", "database_name": "english-geniuses-db" }
  ],
  "observability": { "enabled": true }
}
