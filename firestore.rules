rules_version = '2';
// English Geniuses – Firestore security rules.
// Every device signs in anonymously. Class lists are stored AES-encrypted with the school code;
// progress documents are keyed by student id (no names). Each document holds JSON text in field "j".
service cloud.firestore {
  match /databases/{database}/documents {
    match /config/roster {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.data.j is string
        && request.resource.data.j.size() < 900000;
    }
    match /progress/{sid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && sid.matches('^[A-Za-z0-9._~:@+-]{1,64}$')
        && request.resource.data.j is string
        && request.resource.data.j.size() < 900000;
      allow delete: if request.auth != null;   // used by "Clear all results" in the teacher dashboard
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
